# GLAMDRING :: copia este fichero a .env y rellena solo lo que vayas a usar.
# El .env NUNCA debe subirse a git (ya esta en .gitignore).
#
# Sin ninguna credencial la herramienta funciona igual: ingesta ficheros
# exportados del SIEM, que es el caso mas habitual.

# --- Splunk -----------------------------------------------------------------
# El token se crea en Settings > Tokens. Basta con permiso de busqueda.
SPLUNK_URL=https://splunk.corp.local:8089
SPLUNK_TOKEN=
# Alternativa a token (menos recomendable: la contrasena viaja en cada consulta)
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
# Los Splunk on-prem suelen llevar certificado autofirmado. Pon 0 solo si sabes
# contra que servidor estas hablando.
SPLUNK_VERIFY_TLS=1
SPLUNK_APP=search

# --- Microsoft Sentinel / Log Analytics -------------------------------------
# El Service Principal necesita el rol "Log Analytics Reader" sobre el workspace.
SENTINEL_WORKSPACE_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- IBM QRadar -------------------------------------------------------------
# Token de servicio (Admin > Authorized Services) con permiso de lectura Ariel.
QRADAR_URL=https://qradar.corp.local
QRADAR_TOKEN=
QRADAR_API_VERSION=20.0
QRADAR_VERIFY_TLS=1

# --- Netskope (CASB y SWG) --------------------------------------------------
# Da lo que no da ningun SIEM: la aplicacion cloud concreta, la accion dentro de
# ella (subir, descargar, compartir), el veredicto de la politica y los bytes en
# cada sentido.
NETSKOPE_URL=https://TENANT.goskope.com
NETSKOPE_TOKEN=
# El nombre del iterador. Netskope lleva LA CUENTA por este nombre, asi que dos
# herramientas con el mismo se pisan el puntero: cada una ve los eventos que la
# otra no ha visto y ninguna los ve todos. Cambialo solo si tienes dos GLAMDRING
# contra el mismo tenant, y entonces pon uno distinto en cada uno.
NETSKOPE_ITERATOR=glamdring

# --- Zscaler ----------------------------------------------------------------
# OJO A LA DIVISION, que no es un detalle:
#
#   ZIA (salida a Internet)  ->  sus logs web NO salen por API. Los EMPUJA NSS.
#                                Se configuran en el portal de ZIA, en
#                                Administracion > Nanolog Streaming Service >
#                                Cloud NSS Feed:
#                                  API URL:  https://TU-GLAMDRING/api/receive/zscaler
#                                  Cabecera: X-Glamdring-Key = <clave de la fuente>
#                                y la clave se declara en GLAMDRING_RECEIVE_KEYS.
#
#                                Cloud NSS viene DESACTIVADO en ZIA. Si no ves
#                                la opcion, hay que abrir un caso con Zscaler.
#
#   ZPA (aplicaciones privadas) -> si tiene API REST, y va aqui.
ZPA_URL=https://config.private.zscaler.com
ZPA_CLIENT_ID=
ZPA_CLIENT_SECRET=
ZPA_CUSTOMER_ID=

# --- Limites ----------------------------------------------------------------
GLAMDRING_QUERY_TIMEOUT=120       # segundos por consulta al SIEM
GLAMDRING_MAX_RESULTS=50000       # eventos por consulta
GLAMDRING_MAX_GRAPH_NODES=1500    # por encima el navegador empieza a sufrir

# Permitir que /api/ingest lea rutas del disco del servidor.
# Dejalo en 0 salvo que la herramienta corra en tu propia maquina: activarlo
# convierte el endpoint en una lectura de ficheros arbitrarios.
GLAMDRING_ALLOW_FILE_PATHS=0

# --- Receptor de logs (lo que EMPUJA en vez de dejarse consultar) ------------
# Hace falta porque hay fuentes que no se pueden consultar: los logs web de
# Zscaler ZIA no salen por la API, los empuja NSS. Lo mismo con syslog, los
# webhooks y el HEC de Splunk.
#
# Formato: fuente:clave,fuente:clave
# Una clave POR FUENTE, no una global: asi se rota la de un cliente sin tocar
# las demas, y si se filtra la de un reenviador no queda abierto el resto.
#
# SIN NINGUNA CLAVE EL RECEPTOR NO EXISTE. No hay modo "sin clave" ni para
# pruebas: un receptor abierto en un portatil acaba copiado tal cual a un
# servidor.
#
# Genera cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Menos de 24 caracteres se descarta con aviso: una clave corta deja un
# endpoint que PARECE protegido, que es peor que no tenerlo.
GLAMDRING_RECEIVE_KEYS=

# Tope por envio. Un lote son eventos, no un volcado del indice.
GLAMDRING_RECEIVE_MAX_BYTES=52428800   # 50 MB
# Envios por minuto y por fuente.
GLAMDRING_RECEIVE_PER_MINUTE=120

# --- Clave de la API --------------------------------------------------------
# Vacia = SIN AUTENTICACION, y el arranque lo avisa por consola en cada
# ejecucion. Es lo correcto en el portatil del analista, con el proceso atado a
# loopback; deja de serlo en cuanto esto escucha en una direccion que alcance
# alguien mas.
#
# Sin clave quedan abiertas las 31 operaciones de /api, y no todas hacen el
# mismo dano: GET /api/export entrega el corpus completo del incidente del
# cliente y no vacia nada, asi que nadie se entera de que ha pasado.
#
# Se manda en la cabecera X-Glamdring-Key o como Authorization: Bearer.
# El receptor NO la usa: tiene su propia clave por fuente, y exigir las dos
# obligaria a ponerlas en cada reenviador sin ganar nada.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GLAMDRING_API_KEY=
