# GLAMDRING :: copia este fichero a .env y rellena solo lo que vayas a usar.
# El .env NUNCA debe subirse a git (ya esta en .gitignore).
#
# Sin ninguna credencial la herramienta funciona igual: ingesta ficheros
# exportados del SIEM, que es el caso mas habitual.

# --- Splunk -----------------------------------------------------------------
# El token se crea en Settings > Tokens. Basta con permiso de busqueda.
SPLUNK_URL=https://splunk.corp.local:8089
SPLUNK_TOKEN=
# Alternativa a token (menos recomendable: la contrasena viaja en cada consulta)
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
# Los Splunk on-prem suelen llevar certificado autofirmado. Pon 0 solo si sabes
# contra que servidor estas hablando.
SPLUNK_VERIFY_TLS=1
SPLUNK_APP=search

# --- Microsoft Sentinel / Log Analytics -------------------------------------
# El Service Principal necesita el rol "Log Analytics Reader" sobre el workspace.
SENTINEL_WORKSPACE_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- IBM QRadar -------------------------------------------------------------
# Token de servicio (Admin > Authorized Services) con permiso de lectura Ariel.
QRADAR_URL=https://qradar.corp.local
QRADAR_TOKEN=
QRADAR_API_VERSION=20.0
QRADAR_VERIFY_TLS=1

# --- Limites ----------------------------------------------------------------
GLAMDRING_QUERY_TIMEOUT=120       # segundos por consulta al SIEM
GLAMDRING_MAX_RESULTS=50000       # eventos por consulta
GLAMDRING_MAX_GRAPH_NODES=1500    # por encima el navegador empieza a sufrir

# Permitir que /api/ingest lea rutas del disco del servidor.
# Dejalo en 0 salvo que la herramienta corra en tu propia maquina: activarlo
# convierte el endpoint en una lectura de ficheros arbitrarios.
GLAMDRING_ALLOW_FILE_PATHS=0
